<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>প্রতিশোধ ২.০ – Second Timer Special Course</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --primary: #780000;
    --primary-light: #a00000;
    --primary-glow: rgba(120,0,0,0.4);
    --primary-ultra: rgba(120,0,0,0.08);
    --gold: #c9a84c;
    --gold-light: #e8c97a;
    --dark: #0a0a0a;
    --dark2: #111111;
    --dark3: #181818;
    --dark4: #1e1e1e;
    --glass: rgba(255,255,255,0.04);
    --glass-border: rgba(255,255,255,0.08);
    --text: #f0ece8;
    --text-muted: rgba(240,236,232,0.55);
    --text-dim: rgba(240,236,232,0.3);
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Hind Siliguri', sans-serif;
    background: var(--dark);
    color: var(--text);
    overflow-x: hidden;
    cursor: default;
  }

  /* LOADER */
  #loader {
    position: fixed; inset: 0; z-index: 9999;
    background: var(--dark);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 20px;
    transition: opacity 0.6s ease, visibility 0.6s ease;
  }
  #loader.done { opacity: 0; visibility: hidden; }
  .loader-logo {
    font-size: 2.4rem; font-weight: 700;
    background: linear-gradient(135deg, var(--primary-light), var(--gold));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    animation: pulse 1.5s ease-in-out infinite;
  }
  .loader-bar {
    width: 200px; height: 2px;
    background: rgba(255,255,255,0.1);
    border-radius: 2px; overflow: hidden;
  }
  .loader-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--primary), var(--gold));
    border-radius: 2px;
    animation: loadfill 1.8s ease forwards;
  }
  @keyframes loadfill { from { width: 0 } to { width: 100% } }
  @keyframes pulse { 0%,100% { opacity:1 } 50% { opacity: 0.6 } }

  /* NOISE OVERLAY */
  body::before {
    content: '';
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    opacity: 0.025;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 200px;
  }

  /* ANNOUNCEMENT BAR */
  .announce-bar {
    background: linear-gradient(90deg, var(--primary), #500000, var(--primary));
    background-size: 200% 100%;
    animation: barscroll 4s linear infinite;
    padding: 10px 0; overflow: hidden;
    position: relative; z-index: 100;
  }
  @keyframes barscroll { 0% { background-position: 0% 50% } 100% { background-position: 200% 50% } }
  .announce-track {
    display: flex; gap: 60px;
    animation: marquee 18s linear infinite;
    width: max-content;
  }
  @keyframes marquee { from { transform: translateX(0) } to { transform: translateX(-50%) } }
  .announce-item {
    font-size: 0.82rem; font-weight: 600;
    letter-spacing: 0.12em; white-space: nowrap;
    color: #fff; display: flex; align-items: center; gap: 8px;
  }
  .announce-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--gold); flex-shrink: 0; }

  /* NAVBAR */
  nav {
    position: sticky; top: 0; z-index: 500;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    background: rgba(10,10,10,0.85);
    border-bottom: 1px solid var(--glass-border);
    padding: 0 6%;
    display: flex; align-items: center; justify-content: space-between;
    height: 64px;
  }
  .nav-logo {
    display: flex; align-items: center; gap: 10px;
  }
  .nav-logo-icon {
    width: 38px; height: 38px;
    background: linear-gradient(135deg, var(--primary), #3a0000);
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.1rem; font-weight: 700; color: #fff;
    border: 1px solid rgba(120,0,0,0.5);
    box-shadow: 0 0 18px var(--primary-glow);
  }
  .nav-logo-text { font-size: 1rem; font-weight: 700; letter-spacing: -0.01em; color: var(--text); }
  .nav-links { display: flex; gap: 28px; list-style: none; }
  .nav-links a {
    font-size: 0.85rem; font-weight: 500; color: var(--text-muted);
    text-decoration: none; letter-spacing: 0.02em;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--text); }
  .nav-cta {
    background: linear-gradient(135deg, var(--primary), #550000);
    color: #fff; border: none; cursor: pointer;
    padding: 8px 20px; border-radius: 8px;
    font-size: 0.85rem; font-weight: 600; font-family: 'Hind Siliguri', sans-serif;
    transition: all 0.3s; box-shadow: 0 0 20px var(--primary-glow);
    letter-spacing: 0.02em;
  }
  .nav-cta:hover { transform: translateY(-1px); box-shadow: 0 4px 28px var(--primary-glow); }

  /* HERO */
  .hero {
    min-height: 92vh; position: relative;
    display: flex; align-items: center;
    padding: 80px 6% 60px;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute; inset: 0; z-index: 0;
    background: radial-gradient(ellipse 80% 60% at 70% 40%, rgba(120,0,0,0.18) 0%, transparent 70%),
                radial-gradient(ellipse 50% 40% at 10% 80%, rgba(120,0,0,0.08) 0%, transparent 60%);
  }
  .hero-grid {
    position: absolute; inset: 0; z-index: 0; opacity: 0.04;
    background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px),
                      linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px);
    background-size: 50px 50px;
  }
  .hero-content {
    position: relative; z-index: 2;
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 60px; align-items: center; width: 100%; max-width: 1200px; margin: 0 auto;
  }
  .hero-badge {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(120,0,0,0.2); border: 1px solid rgba(120,0,0,0.4);
    padding: 5px 14px; border-radius: 100px;
    font-size: 0.78rem; font-weight: 600; letter-spacing: 0.08em;
    color: #ff8080; margin-bottom: 20px; text-transform: uppercase;
  }
  .hero-badge-dot { width: 6px; height: 6px; border-radius: 50%; background: #ff4040; animation: blink 1.5s ease infinite; }
  @keyframes blink { 0%,100% { opacity:1 } 50% { opacity:0.3 } }
  .hero-title {
    font-size: clamp(2.8rem, 6vw, 5rem);
    font-weight: 700; line-height: 1.0;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, #fff 30%, var(--gold) 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    margin-bottom: 6px;
    animation: fadeup 0.8s ease both;
  }
  .hero-subtitle {
    font-size: 1.1rem; font-weight: 500;
    color: var(--gold); letter-spacing: 0.04em;
    margin-bottom: 24px; text-transform: uppercase;
    animation: fadeup 0.8s 0.15s ease both;
  }
  .hero-desc {
    font-size: 1rem; line-height: 1.9;
    color: var(--text-muted); max-width: 520px;
    animation: fadeup 0.8s 0.3s ease both;
    margin-bottom: 36px;
  }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; animation: fadeup 0.8s 0.45s ease both; }
  @keyframes fadeup { from { opacity:0; transform: translateY(24px) } to { opacity:1; transform: translateY(0) } }

  .btn-primary {
    background: linear-gradient(135deg, var(--primary), #550000);
    color: #fff; border: none; cursor: pointer;
    padding: 14px 32px; border-radius: 10px;
    font-size: 1rem; font-weight: 700; font-family: 'Hind Siliguri', sans-serif;
    transition: all 0.3s; box-shadow: 0 4px 30px var(--primary-glow);
    position: relative; overflow: hidden;
    letter-spacing: 0.02em;
  }
  .btn-primary::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.1), transparent);
    opacity: 0; transition: opacity 0.3s;
  }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 40px var(--primary-glow); }
  .btn-primary:hover::after { opacity: 1; }
  .btn-primary:active { transform: scale(0.97); }

  .btn-secondary {
    background: var(--glass); color: var(--text);
    border: 1px solid var(--glass-border); cursor: pointer;
    padding: 14px 28px; border-radius: 10px;
    font-size: 1rem; font-weight: 600; font-family: 'Hind Siliguri', sans-serif;
    transition: all 0.3s; letter-spacing: 0.02em;
    backdrop-filter: blur(8px);
  }
  .btn-secondary:hover { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.15); }

  /* HERO ILLUSTRATION */
  .hero-visual {
    position: relative; height: 420px;
    display: flex; align-items: center; justify-content: center;
    animation: fadeup 0.8s 0.3s ease both;
  }
  .blob {
    position: absolute; border-radius: 50%;
    filter: blur(60px); pointer-events: none;
  }
  .blob-1 { width: 300px; height: 300px; background: rgba(120,0,0,0.3); top: 20%; left: 50%; transform: translateX(-50%); animation: float1 6s ease-in-out infinite; }
  .blob-2 { width: 200px; height: 200px; background: rgba(201,168,76,0.15); bottom: 10%; right: 10%; animation: float2 8s ease-in-out infinite; }
  @keyframes float1 { 0%,100% { transform: translateX(-50%) translateY(0) } 50% { transform: translateX(-50%) translateY(-20px) } }
  @keyframes float2 { 0%,100% { transform: translateY(0) } 50% { transform: translateY(16px) } }
  .dashboard-card {
    background: rgba(20,20,20,0.8);
    border: 1px solid rgba(120,0,0,0.3);
    border-radius: 18px;
    padding: 24px;
    backdrop-filter: blur(20px);
    width: 320px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.5), 0 0 40px rgba(120,0,0,0.1);
    position: relative; z-index: 2;
  }
  .dash-header { font-size: 0.75rem; font-weight: 600; color: var(--text-dim); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 16px; }
  .dash-stat { margin-bottom: 18px; }
  .dash-stat-label { font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px; }
  .dash-stat-value { font-size: 1.6rem; font-weight: 700; color: var(--text); }
  .dash-stat-sub { font-size: 0.75rem; color: #4caf50; }
  .dash-bar { height: 4px; background: rgba(255,255,255,0.08); border-radius: 4px; margin-bottom: 14px; overflow: hidden; }
  .dash-bar-fill { height: 100%; border-radius: 4px; background: linear-gradient(90deg, var(--primary), var(--gold)); }
  .dash-subjects { display: flex; gap: 6px; flex-wrap: wrap; }
  .subj-tag { font-size: 0.7rem; padding: 4px 10px; background: rgba(120,0,0,0.2); border: 1px solid rgba(120,0,0,0.3); border-radius: 100px; color: #ff9090; }
  .float-badge {
    position: absolute; background: rgba(20,20,20,0.9);
    border: 1px solid rgba(201,168,76,0.3); border-radius: 12px;
    padding: 10px 16px; backdrop-filter: blur(10px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.4);
    animation: floatbadge 4s ease-in-out infinite;
  }
  .float-badge-1 { top: 30px; right: -10px; animation-delay: 0s; }
  .float-badge-2 { bottom: 50px; left: -30px; animation-delay: 2s; }
  @keyframes floatbadge { 0%,100% { transform: translateY(0) } 50% { transform: translateY(-8px) } }
  .fb-label { font-size: 0.7rem; color: var(--text-dim); }
  .fb-val { font-size: 0.9rem; font-weight: 700; color: var(--gold); }

  /* SECTION COMMONS */
  section { position: relative; z-index: 1; }
  .section-label {
    font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em;
    color: var(--primary-light); text-transform: uppercase;
    margin-bottom: 10px; display: flex; align-items: center; gap: 8px;
  }
  .section-label::before { content: ''; display: block; width: 20px; height: 1px; background: var(--primary-light); }
  .section-title {
    font-size: clamp(1.8rem, 3.5vw, 2.8rem); font-weight: 700;
    line-height: 1.2; letter-spacing: -0.01em;
    color: var(--text); margin-bottom: 16px;
  }
  .section-desc { font-size: 1rem; line-height: 1.8; color: var(--text-muted); max-width: 560px; }
  .section-center { text-align: center; }
  .section-center .section-label { justify-content: center; }
  .section-center .section-label::before { display: none; }
  .section-center .section-desc { margin: 0 auto; }
  .container { max-width: 1200px; margin: 0 auto; padding: 80px 6%; }

  /* DIVIDER */
  .divider { height: 1px; background: linear-gradient(90deg, transparent, rgba(120,0,0,0.4), transparent); margin: 0 6%; }

  /* COUNTDOWN */
  .countdown-section {
    background: linear-gradient(135deg, rgba(120,0,0,0.12), rgba(20,20,20,0.8));
    border-top: 1px solid rgba(120,0,0,0.2);
    border-bottom: 1px solid rgba(120,0,0,0.2);
    padding: 60px 6%;
    text-align: center;
    position: relative; overflow: hidden;
  }
  .countdown-section::before {
    content: ''; position: absolute; top: -100px; left: 50%; transform: translateX(-50%);
    width: 600px; height: 200px;
    background: radial-gradient(ellipse, rgba(120,0,0,0.3), transparent);
    pointer-events: none;
  }
  .countdown-label { font-size: 0.85rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 30px; }
  .countdown-grid { display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; margin-bottom: 24px; }
  .countdown-item {
    display: flex; flex-direction: column; align-items: center;
    background: rgba(20,20,20,0.7); border: 1px solid rgba(120,0,0,0.25);
    border-radius: 14px; padding: 20px 30px;
    min-width: 100px;
    backdrop-filter: blur(10px);
    position: relative; overflow: hidden;
  }
  .countdown-item::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(120,0,0,0.6), transparent);
  }
  .countdown-num {
    font-size: 3rem; font-weight: 700; line-height: 1;
    background: linear-gradient(135deg, #fff, var(--gold));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    font-variant-numeric: tabular-nums;
  }
  .countdown-unit { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); margin-top: 6px; }
  .countdown-colon { font-size: 2.5rem; font-weight: 700; color: rgba(120,0,0,0.6); align-self: center; line-height: 1; }
  .admin-timer-link {
    font-size: 0.75rem; color: var(--text-dim); cursor: pointer;
    text-decoration: underline; text-underline-offset: 3px;
    background: none; border: none; font-family: 'Hind Siliguri', sans-serif;
  }
  .admin-timer-link:hover { color: var(--text-muted); }

  /* FEATURES */
  .features-section { padding: 80px 6%; }
  .features-container { max-width: 1200px; margin: 0 auto; }
  .features-head { margin-bottom: 50px; }
  .features-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin-bottom: 50px; }
  .feature-card {
    background: var(--dark3);
    border: 1px solid var(--glass-border);
    border-radius: 16px; padding: 24px;
    transition: all 0.3s; position: relative; overflow: hidden;
  }
  .feature-card::before {
    content: ''; position: absolute; inset: 0; border-radius: 16px;
    background: linear-gradient(135deg, rgba(120,0,0,0.06), transparent);
    opacity: 0; transition: opacity 0.3s;
  }
  .feature-card:hover { border-color: rgba(120,0,0,0.4); transform: translateY(-3px); box-shadow: 0 12px 40px rgba(0,0,0,0.3), 0 0 30px rgba(120,0,0,0.08); }
  .feature-card:hover::before { opacity: 1; }
  .feature-icon {
    width: 44px; height: 44px; border-radius: 11px;
    background: linear-gradient(135deg, rgba(120,0,0,0.3), rgba(80,0,0,0.2));
    border: 1px solid rgba(120,0,0,0.3);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 16px;
  }
  .feature-icon svg { width: 22px; height: 22px; }
  .feature-title { font-size: 1rem; font-weight: 700; color: var(--text); margin-bottom: 6px; }
  .feature-desc { font-size: 0.85rem; line-height: 1.7; color: var(--text-muted); }

  .subjects-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 10px; margin-bottom: 40px; }
  .subj-card {
    background: var(--dark3); border: 1px solid var(--glass-border);
    border-radius: 12px; padding: 16px;
    text-align: center; transition: all 0.25s;
  }
  .subj-card:hover { border-color: rgba(201,168,76,0.3); background: rgba(201,168,76,0.04); }
  .subj-name { font-size: 0.9rem; font-weight: 600; color: var(--text); }

  .extras-title { font-size: 1.2rem; font-weight: 700; color: var(--text); margin-bottom: 20px; }
  .extras-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 10px; }
  .extra-item {
    display: flex; align-items: center; gap: 12px;
    background: var(--dark3); border: 1px solid var(--glass-border);
    border-radius: 10px; padding: 12px 16px;
    font-size: 0.88rem; color: var(--text-muted); transition: all 0.2s;
  }
  .extra-item:hover { border-color: rgba(120,0,0,0.3); color: var(--text); }
  .extra-check { width: 18px; height: 18px; flex-shrink: 0; }

  /* PRICING */
  .pricing-section { padding: 80px 6%; }
  .pricing-container { max-width: 640px; margin: 0 auto; text-align: center; }
  .pricing-card {
    background: linear-gradient(135deg, rgba(20,20,20,0.9), rgba(30,10,10,0.9));
    border: 1px solid rgba(120,0,0,0.3);
    border-radius: 24px; padding: 50px 40px;
    position: relative; overflow: hidden;
    backdrop-filter: blur(10px);
    box-shadow: 0 20px 60px rgba(0,0,0,0.5), 0 0 60px rgba(120,0,0,0.1);
  }
  .pricing-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(120,0,0,0.7), var(--gold-light), rgba(120,0,0,0.7), transparent);
  }
  .early-badge {
    display: inline-flex; align-items: center; gap: 6px;
    background: linear-gradient(135deg, rgba(201,168,76,0.2), rgba(201,168,76,0.1));
    border: 1px solid rgba(201,168,76,0.3);
    padding: 6px 16px; border-radius: 100px;
    font-size: 0.75rem; font-weight: 600; color: var(--gold);
    letter-spacing: 0.1em; text-transform: uppercase;
    margin-bottom: 28px;
  }
  .price-display {
    font-size: 1.2rem; font-weight: 500; color: var(--text-muted);
    margin-bottom: 12px;
  }
  .price-blur {
    font-size: 3.5rem; font-weight: 700;
    filter: blur(10px); color: var(--gold);
    user-select: none; margin-bottom: 16px;
    transition: filter 0.3s;
  }
  .price-announce { font-size: 1rem; color: var(--text-muted); line-height: 1.7; margin-bottom: 30px; }
  .price-card-cta { width: 100%; padding: 16px; font-size: 1.1rem; }

  /* TESTIMONIALS */
  .testimonials-section { padding: 80px 6%; background: var(--dark2); }
  .testi-container { max-width: 1200px; margin: 0 auto; }
  .testi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; margin-top: 40px; }
  .testi-card {
    background: var(--dark3); border: 1px solid var(--glass-border);
    border-radius: 16px; padding: 24px; transition: all 0.3s;
  }
  .testi-card:hover { border-color: rgba(120,0,0,0.3); }
  .testi-quote {
    font-size: 0.95rem; line-height: 1.8; color: var(--text-muted);
    margin-bottom: 20px; font-style: italic;
    position: relative; padding-left: 16px;
  }
  .testi-quote::before { content: ''; position: absolute; left: 0; top: 4px; width: 2px; height: calc(100% - 8px); background: var(--primary-light); border-radius: 2px; }
  .testi-author { display: flex; align-items: center; gap: 12px; }
  .testi-avatar {
    width: 40px; height: 40px; border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), #3a0000);
    display: flex; align-items: center; justify-content: center;
    font-size: 0.9rem; font-weight: 700; color: #fff;
    border: 1px solid rgba(120,0,0,0.4);
  }
  .testi-name { font-size: 0.9rem; font-weight: 700; color: var(--text); }
  .testi-batch { font-size: 0.75rem; color: var(--text-dim); }
  .testi-stars { color: var(--gold); font-size: 0.8rem; letter-spacing: 2px; margin-bottom: 8px; }

  /* FAQ */
  .faq-section { padding: 80px 6%; }
  .faq-container { max-width: 760px; margin: 0 auto; }
  .faq-list { margin-top: 40px; display: flex; flex-direction: column; gap: 10px; }
  .faq-item {
    background: var(--dark3); border: 1px solid var(--glass-border);
    border-radius: 12px; overflow: hidden; transition: border-color 0.3s;
  }
  .faq-item.open { border-color: rgba(120,0,0,0.3); }
  .faq-question {
    display: flex; justify-content: space-between; align-items: center;
    padding: 18px 22px; cursor: pointer;
    font-size: 0.95rem; font-weight: 600; color: var(--text);
