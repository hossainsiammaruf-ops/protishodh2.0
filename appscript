      <label class="form-label">Target Date & Time</label>
      <input type="datetime-local" class="form-input" id="admin-date">
    </div>
    <div style="display:flex;gap:10px;margin-top:8px">
      <button class="btn-primary" style="flex:1;padding:12px;font-size:0.9rem" onclick="setAdminDate()">Save</button>
      <button class="btn-secondary" style="flex:1;padding:12px;font-size:0.9rem" onclick="closeAdmin()">Cancel</button>
    </div>
  </div>
</div>

<script>
// LOADER
window.addEventListener('load', () => {
  setTimeout(() => { document.getElementById('loader').classList.add('done'); }, 2000);
});

// COUNTDOWN
let targetDate = localStorage.getItem('countdownTarget')
  ? new Date(localStorage.getItem('countdownTarget'))
  : new Date(Date.now() + 30 * 24 * 60 * 60 * 1000);

function pad(n) { return String(n).padStart(2, '0'); }
function updateCountdown() {
  const diff = targetDate - Date.now();
  if (diff <= 0) {
    ['cd-days','cd-hours','cd-mins','cd-secs'].forEach(id => document.getElementById(id).textContent = '00');
    return;
  }
  const d = Math.floor(diff / 86400000);
  const h = Math.floor((diff % 86400000) / 3600000);
  const m = Math.floor((diff % 3600000) / 60000);
  const s = Math.floor((diff % 60000) / 1000);
  document.getElementById('cd-days').textContent = pad(d);
  document.getElementById('cd-hours').textContent = pad(h);
  document.getElementById('cd-mins').textContent = pad(m);
  document.getElementById('cd-secs').textContent = pad(s);
}
updateCountdown();
setInterval(updateCountdown, 1000);

// ADMIN
function openAdmin() { document.getElementById('adminOverlay').classList.add('open'); }
function closeAdmin() { document.getElementById('adminOverlay').classList.remove('open'); }
function handleAdminOverlay(e) { if (e.target === document.getElementById('adminOverlay')) closeAdmin(); }
function setAdminDate() {
  const val = document.getElementById('admin-date').value;
  if (!val) return;
  targetDate = new Date(val);
  localStorage.setItem('countdownTarget', targetDate.toISOString());
  closeAdmin();
  updateCountdown();
}

// MODAL
function openModal() { document.getElementById('modalOverlay').classList.add('open'); }
function closeModal() {
  document.getElementById('modalOverlay').classList.remove('open');
  document.getElementById('formView').style.display = '';
  document.getElementById('ticketView').style.display = 'none';
}
function handleOverlayClick(e) { if (e.target === document.getElementById('modalOverlay')) closeModal(); }

// FAQ
function toggleFaq(el) {
  const item = el.parentElement;
  const isOpen = item.classList.contains('open');
  document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
  if (!isOpen) item.classList.add('open');
}

// FORM SUBMIT
function submitForm() {
  const name = document.getElementById('f-name').value.trim();
  const phone = document.getElementById('f-phone').value.trim();
  const college = document.getElementById('f-college').value.trim();
  const batch = document.getElementById('f-batch').value;
  const gender = document.getElementById('f-gender').value;
  const coupon = document.getElementById('f-coupon').value.trim();

  if (!name || !phone || !college || !batch || !gender) {
    alert('অনুগ্রহ করে সকল বাধ্যতামূলক তথ্য পূরণ করো।');
    return;
  }
  if (!/^01[3-9]\d{8}$/.test(phone)) {
    alert('সঠিক ফোন নম্বর দাও।');
    return;
  }

  const btn = document.getElementById('submitBtn');
  btn.textContent = 'Submitting...';
  btn.disabled = true;

  const uid = 'PRE-' + Date.now().toString(36).toUpperCase() + '-' + Math.random().toString(36).slice(2,6).toUpperCase();
  const timestamp = new Date().toLocaleString('bn-BD');

  // Google Sheets Integration via Apps Script
  // Replace the URL below with your Google Apps Script Web App URL
  const APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbzwtOZ7eU5pokVOt7MVS1AL3zO2fIe65mtdRQ4ArU7jATX-TeokXxWaAQc3jO4Ra1PSUA/exec';

  const payload = { timestamp, name, phone, college, batch, gender, coupon: coupon || 'N/A', uid };

  fetch(APPS_SCRIPT_URL, {
    method: 'POST',
    mode: 'no-cors',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload)
  }).catch(() => {}).finally(() => {
    // Show ticket regardless (no-cors won't give us response)
    document.getElementById('formView').style.display = 'none';
    const tv = document.getElementById('ticketView');
    tv.style.display = 'block';
    document.getElementById('ticket-name').textContent = name;
    document.getElementById('ticket-id').textContent = uid;
    btn.textContent = 'Pre-Book Now';
    btn.disabled = false;
  });
}

// SCROLL REVEAL
const observer = new IntersectionObserver((entries) => {
  entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

// PARALLAX
window.addEventListener('scroll', () => {
  const y = window.scrollY;
  const bg = document.querySelector('.hero-bg');
  if (bg) bg.style.transform = `translateY(${y * 0.2}px)`;
});
</script>
